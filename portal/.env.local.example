# ------------------------------------------------------------------
# Coffs Coast Pest Control — Client Social Media Approval Portal
# Environment variables. Copy this file to `.env.local` (local dev)
# and set the same variables in your Vercel project dashboard.
# NEVER commit real values. `.env*.local` is git-ignored.
# ------------------------------------------------------------------

# --- Portal access password (required) ---------------------------
# A shared secret the client enters to unlock the dashboard.
# Use a strong, unique value. Example: ChangeMe_To_A_Strong_Password
PORTAL_PASSWORD=CHANGE_ME_set_a_strong_password

# --- Supabase (required for captions + approval status) ----------
# Find these in Supabase Dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Use the project's public API key (anon "sb_anon_..." or publishable
# "sb_publishable_..."). Keep this public-safe; it works with the RLS
# "public_access" policy shipped in supabase/schema.sql.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_YOUR_PUBLIC_KEY

# --- Schedule (optional overrides) -------------------------------
# ISO date strings controlling which image appears on which day.
# If omitted, the portal falls back to its built-in defaults.
SCHEDULE_OFFSET_DAYS=0

# --- Monthly notification hook (10-to-6 batch workflow) ----------
# The client is notified when 10 new content options are ready for
# review, then picks 6. Either channel works (n8n webhook OR SMTP).
# n8n: create a webhook URL that triggers an email/notification workflow.
N8N_WEBHOOK_URL=
# Direct SMTP email notification (no n8n). Used by the montage worker to
# email the generated-asset list + ZIP download link when a batch completes.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# Password for SMTP_USER (worker reads SMTP_PASSWORD; SMTP_PASS is kept for
# backward compatibility with the older /api/notify SMTP path).
SMTP_PASSWORD=
SMTP_PASS=
SMTP_FROM=
# Recipient for the monthly "content ready" email (e.g. owner + client).
CLIENT_NOTIFY_EMAIL=
# Recipient for the worker's batch-ready email (e.g. the studio/owner).
NOTIFICATION_EMAIL=mail.danmueller@gmail.com

# --- Supabase Storage (production persistence) -------------------
# The montage worker uploads each generated ZIP bundle to a Supabase Storage
# bucket so downloads keep working on serverless (Vercel) deployments, where
# files written to public/zips/ are erased after each Lambda lifecycle.
# Create a bucket named below in Supabase Dashboard -> Storage and make it
# PUBLIC (so the dashboard + email links can download without auth).
SUPABASE_STORAGE_BUCKET=asset-bundles
SUPABASE_STORAGE_PREFIX=zips

# --- Gemini conceptualization (montage worker / on-demand batch) --
# Optional. When set, the worker uses Gemini to drive image/video caption
# conceptualization. Falls back to deterministic static captions if unset.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_REST_ENDPOINT=https://generativelanguage.googleapis.com/v1beta

# --- Cron guard (optional) ----------------------------------------
# Protect /api/cron/notify when you schedule it on Vercel.
CRON_SECRET=

